FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
# Native workers intentionally omit the browser runtime. FFmpeg ASS and Skia must not
# reserve or launch a browser process; this keeps their memory profile small.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates fonts-noto-core fonts-noto-extra fonts-hosny-amiri fontconfig libass9 libharfbuzz0b && rm -rf /var/lib/apt/lists/*
COPY scripts/verify-render-runtime.sh /usr/local/bin/verify-render-runtime
RUN chmod +x /usr/local/bin/verify-render-runtime && /usr/local/bin/verify-render-runtime
COPY --from=build /app/package*.json ./
RUN npm ci --include=dev
ENV NODE_ENV=production
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/server ./server
COPY --from=build /app/shared ./shared
COPY --from=build /app/database ./database
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe
CMD ["node", "dist-server/worker.cjs"]

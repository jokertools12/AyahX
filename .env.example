# ==============================================================================
# Quran Reels & Ibtahalat Maker - Environment Configuration Template
# Copy this file to .env and configure your local or deployment parameters.
# NEVER commit real credentials, production secrets, or API keys to this file.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
TRUST_PROXY_HOPS=1
# Default 20 in production. Raise only in a dedicated staging load-test environment.
AUTH_RATE_LIMIT_MAX=20
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Authentication Security (Must be set to a secure 256-bit secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# MySQL 8.0+ Database Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=quran_reels

# AI Services (Optional - Used for audio transcription and timing refinement)
# Supports Google Gemini API (gemini-1.5-flash) or Lovable AI Gateway
GEMINI_API_KEY=
LOVABLE_API_KEY=

# Third-Party Stock Video Search (Optional - Pexels Video API)
# Injected server-side via /api/services/pexels/search; keep out of client builds
PEXELS_API_KEY=

# Production rendering: keep API nodes stateless and run `npm run worker` in
# three independent worker services. Leave driver as database for local development.
RENDER_QUEUE_DRIVER=database
REDIS_URL=redis://localhost:6379
RENDER_WORKER_ID=
# Each production worker consumes only its own BullMQ queue. API/control
# services leave this unset.
RENDER_WORKER_ENGINE=ffmpeg_ass
# Per-engine admission profiles. These are starting points for a 2GB worker
# replica and must be tuned from cgroup peak/OOM metrics, never from 100/50MB.
RENDER_CAPACITY_HARD_MAX=8
FFMPEG_RENDER_MEMORY_PER_JOB_MB=256
FFMPEG_RENDER_MEMORY_RESERVE_MB=512
FFMPEG_RENDER_CPU_PER_JOB=1
FFMPEG_RENDER_MAX_CONCURRENCY=auto
SKIA_RENDER_MEMORY_PER_JOB_MB=512
SKIA_RENDER_MEMORY_RESERVE_MB=512
SKIA_RENDER_CPU_PER_JOB=1.5
SKIA_RENDER_MAX_CONCURRENCY=auto
BROWSER_RENDER_MEMORY_PER_JOB_MB=900
BROWSER_RENDER_MEMORY_RESERVE_MB=512
BROWSER_RENDER_CPU_PER_JOB=2
BROWSER_RENDER_MAX_CONCURRENCY=auto
RENDER_JOB_TIMEOUT_MS=900000
RENDER_LOCK_DURATION_MS=120000
RENDER_MAX_BACKLOG=2000
FFMPEG_RENDER_REPLICAS=2
SKIA_RENDER_REPLICAS=2
BROWSER_RENDER_REPLICAS=2
FFMPEG_RENDER_SERVICE_ID=
SKIA_RENDER_SERVICE_ID=
BROWSER_RENDER_SERVICE_ID=
FFMPEG_RENDER_SLOTS_PER_REPLICA=3
SKIA_RENDER_SLOTS_PER_REPLICA=2
BROWSER_RENDER_SLOTS_PER_REPLICA=2
FFMPEG_RENDER_MIN_REPLICAS=2
SKIA_RENDER_MIN_REPLICAS=2
BROWSER_RENDER_MIN_REPLICAS=2
FFMPEG_RENDER_MAX_REPLICAS=6
SKIA_RENDER_MAX_REPLICAS=6
BROWSER_RENDER_MAX_REPLICAS=6
# The token is a Railway project token scoped to this production environment.
# Keep it only in Railway variables; never commit it or put it in frontend env.
RAILWAY_ENVIRONMENT_ID=
RAILWAY_AUTOSCALER_ENABLED=false
RAILWAY_AUTOSCALER_TOKEN=
RAILWAY_AUTOSCALER_POLL_SECONDS=15
RAILWAY_AUTOSCALER_IDLE_MINUTES=15
ENGINE_FFMPEG_ENABLED=true
ENGINE_SKIA_ENABLED=true
ENGINE_BROWSER_ENABLED=true
RENDER_CAPACITY_POLL_MS=5000
RENDER_FFMPEG_PRESET=
RENDER_FFMPEG_THREADS=0
RENDER_JPEG_QUALITY=90
RENDER_SCREENSHOT_OPTIMIZE=true
# Keep Chromium/CDP calls recoverable on long renders. The frame-level
# deadline is shorter and recycles the browser when it stops responding.
RENDER_PROTOCOL_TIMEOUT_MS=300000
RENDER_FRAME_OPERATION_TIMEOUT_MS=45000
RENDER_FRAME_RECOVERY_ATTEMPTS=2
# 0 means automatic: 1080p uses 90 frames, 4K uses 45 frames.
RENDER_BROWSER_FRAME_BATCH_SIZE=0
# Keep compositor capture on by default so every canvas update is captured.
# Set false only after validating that a specific Chromium build has no stale
# frame behaviour with view capture.
RENDER_SCREENSHOT_FROM_SURFACE=true

# Shared artifact storage. Use S3-compatible Cloudflare R2, AWS S3 or MinIO.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
METRICS_TOKEN=
RENDER_ALERT_WEBHOOK_URL=
RENDER_ALERT_COOLDOWN_MINUTES=15
# Staging load simulator only. Keep unset/0 in production.
RENDER_SIMULATE=0
RENDER_SIMULATE_MS=1000
RENDER_SIMULATE_MEMORY_MB=64
RENDER_SIMULATE_CPU_MS=100

# ==============================================================================
# Quran Reels & Ibtahalat Maker - Environment Configuration Template
# Copy this file to .env and configure your local or deployment parameters.
# NEVER commit real credentials, production secrets, or API keys to this file.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
TRUST_PROXY_HOPS=1
# Default 20 in production. Raise only in a dedicated staging load-test environment.
AUTH_RATE_LIMIT_MAX=20
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Authentication Security (Must be set to a secure 256-bit secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
# Required only when using the admin settings screen to store API secrets in
# MySQL. Generate a random 32-byte value (hex or base64) and keep it separate
# from the database. Railway-managed environment variables can be used
# instead, but this key is still required for encrypted DB-backed settings.
SETTINGS_ENCRYPTION_KEY=

# MySQL 8.0+ Database Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=quran_reels
MYSQL_POOL_SIZE=5

# AI Services — explicit provider selection (server-side only)
#
# Recommended production configuration: OpenRouter.  Create a key at
# https://openrouter.ai/keys and save it only as a Railway service variable or
# in a local .env file that is never committed.  Never prefix this with VITE_.
# The default text path uses one explicitly pinned free model with structured output:
#   qwen/qwen3.8-27b:free
# Ultra is excluded because the live catalog does not declare structured output;
# Ling Sante is medical-focused; Space Bunny is blocked while privacy is deny.
# OpenRouter availability and free quotas can change, so the admin test checks
# the live catalog before enabling a deployment.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_TEXT_FALLBACK_MODELS=
OPENROUTER_MODEL_FALLBACKS_ENABLED=false
# Do not quietly use a different model or upstream provider.
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=false
OPENROUTER_DATA_COLLECTION=deny
# `deny` also requires OpenRouter Zero Data Retention routing on each request.
OPENROUTER_FREE_ONLY=true
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=AyahX
# OpenRouter is configured for text only. Audio and Quran word timing use
# separate, explicitly selected processing paths.

# Gemini remains an optional, explicitly separate image-generation provider.
# It is not selected for text/audio when AI_PROVIDER=openrouter.
AI_IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
LOVABLE_API_KEY=

# Third-Party Stock Video Search (Optional - Pexels Video API)
# Injected server-side via /api/services/pexels/search; keep out of client builds
PEXELS_API_KEY=

# Production rendering: keep API nodes stateless and run `npm run worker` in
# one Skia worker service. Other engines are opt-in diagnostics.
RENDER_QUEUE_DRIVER=database
REDIS_URL=redis://localhost:6379
RENDER_WORKER_ID=
# Each production worker consumes only its own BullMQ queue. API/control
# services leave this unset.
RENDER_WORKER_ENGINE=skia_canvas
# Per-engine admission profiles. These are starting points for a 2GB worker
# replica and must be tuned from cgroup peak/OOM metrics, never from 100/50MB.
RENDER_CAPACITY_HARD_MAX=1
FFMPEG_RENDER_MEMORY_PER_JOB_MB=256
FFMPEG_RENDER_MEMORY_RESERVE_MB=512
FFMPEG_RENDER_CPU_PER_JOB=1
FFMPEG_RENDER_MAX_CONCURRENCY=auto
SKIA_RENDER_MEMORY_PER_JOB_MB=512
SKIA_RENDER_MEMORY_RESERVE_MB=512
SKIA_RENDER_CPU_PER_JOB=1.5
SKIA_RENDER_MAX_CONCURRENCY=1
BROWSER_RENDER_MEMORY_PER_JOB_MB=900
BROWSER_RENDER_MEMORY_RESERVE_MB=512
BROWSER_RENDER_CPU_PER_JOB=2
BROWSER_RENDER_MAX_CONCURRENCY=auto
RENDER_JOB_TIMEOUT_MS=900000
RENDER_LOCK_DURATION_MS=120000
RENDER_MAX_BACKLOG=50
# Per-worker on-disk LRU cache for downloaded audio/background assets.
RENDER_ASSET_CACHE_MB=64
FFMPEG_RENDER_REPLICAS=0
SKIA_RENDER_REPLICAS=1
BROWSER_RENDER_REPLICAS=0
FFMPEG_RENDER_SERVICE_ID=
SKIA_RENDER_SERVICE_ID=
BROWSER_RENDER_SERVICE_ID=
FFMPEG_RENDER_SLOTS_PER_REPLICA=3
SKIA_RENDER_SLOTS_PER_REPLICA=1
BROWSER_RENDER_SLOTS_PER_REPLICA=2
FFMPEG_RENDER_MIN_REPLICAS=0
SKIA_RENDER_MIN_REPLICAS=1
BROWSER_RENDER_MIN_REPLICAS=0
FFMPEG_RENDER_MAX_REPLICAS=0
SKIA_RENDER_MAX_REPLICAS=1
BROWSER_RENDER_MAX_REPLICAS=0
# The token is a Railway project token scoped to this production environment.
# Keep it only in Railway variables; never commit it or put it in frontend env.
RAILWAY_ENVIRONMENT_ID=
RAILWAY_AUTOSCALER_ENABLED=false
RAILWAY_AUTOSCALER_TOKEN=
RAILWAY_AUTOSCALER_POLL_SECONDS=15
RAILWAY_AUTOSCALER_IDLE_MINUTES=15
ENGINE_FFMPEG_ENABLED=false
ENGINE_SKIA_ENABLED=true
ENGINE_BROWSER_ENABLED=false
RENDER_CAPACITY_POLL_MS=5000
RENDER_FFMPEG_PRESET=veryfast
RENDER_FFMPEG_THREADS=1
RENDER_JPEG_QUALITY=90
RENDER_SCREENSHOT_OPTIMIZE=true
# Keep Chromium/CDP calls recoverable on long renders. The frame-level
# deadline is shorter and recycles the browser when it stops responding.
RENDER_PROTOCOL_TIMEOUT_MS=300000
RENDER_FRAME_OPERATION_TIMEOUT_MS=45000
RENDER_FRAME_RECOVERY_ATTEMPTS=2
# 0 means automatic: 1080p uses 90 frames, 4K uses 45 frames.
RENDER_BROWSER_FRAME_BATCH_SIZE=0
# Keep compositor capture on by default so every canvas update is captured.
# Set false only after validating that a specific Chromium build has no stale
# frame behaviour with view capture.
RENDER_SCREENSHOT_FROM_SURFACE=true

# Shared artifact storage. Use S3-compatible Cloudflare R2, AWS S3 or MinIO.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
METRICS_TOKEN=
RENDER_ALERT_WEBHOOK_URL=
RENDER_ALERT_COOLDOWN_MINUTES=15
# Optional Redis max-memory budget used when Redis itself reports maxmemory=0.
REDIS_MEMORY_LIMIT_MB=512
# Staging load simulator only. Keep unset/0 in production.
RENDER_SIMULATE=0
RENDER_SIMULATE_MS=1000
RENDER_SIMULATE_MEMORY_MB=64
RENDER_SIMULATE_CPU_MS=100

# ============================================================================
# Exact Quran word alignment (server-side only)
# ============================================================================
# The browser never supplies trusted timing evidence. Timing maps must come
# from an approved internal or explicitly reviewed adapter.

# Approved map output is bound to the requesting user with a short-lived HMAC.
# Use a new random value of at least 32 characters in every production env.
ALIGNMENT_ATTESTATION_SECRET=
ALIGNMENT_ATTESTATION_TTL_SECONDS=86400

# Internal CTC adapter. The Node API calls this URL only when providerId is
# explicitly internal_ctc; there is no automatic fallback to another provider.
ALIGNMENT_INTERNAL_CTC_URL=
ALIGNMENT_INTERNAL_CTC_TOKEN=

# FastAPI worker settings. The control image intentionally has no model by
# default and returns MODEL_NOT_CONFIGURED until an approved engine is attached.
ALIGNMENT_WORKER_SHARED_TOKEN=
ALIGNMENT_ALLOW_UNAUTHENTICATED=false
ALIGNMENT_ENGINE_MODULE=
ALIGNMENT_ENGINE_COMMAND=
ALIGNMENT_CTC_MODEL_ID=
# Pin an immutable model revision in production; `main` is development-only.
ALIGNMENT_CTC_MODEL_REVISION=
ALIGNMENT_CTC_DEVICE=auto
ALIGNMENT_CTC_MAX_TRELLIS_CELLS=20000000
ALIGNMENT_AUDIO_ALLOWED_HOSTS=audio.qurancdn.com,verses.quran.com,download.quranicaudio.com,everyayah.com,www.everyayah.com
ALIGNMENT_AUDIO_ASSET_ROOT=/data/audio

# Explicit external adapters. They are disabled when empty and never become a
# silent fallback. Lafzize additionally requires legal approval below.
QUA_ALIGNER_API_URL=
QUA_ALIGNER_API_TOKEN=
LAFZIZE_API_URL=
LAFZIZE_API_TOKEN=
LAFZIZE_LICENSE_REVIEW_APPROVED=false
ALIGNMENT_VERIFIED_DATASET_ENABLED=false
ALIGNMENT_VERIFIED_DATASET_ATTESTATION=

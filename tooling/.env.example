# Toolkit only. Copy to tooling/.env.local; never commit real keys.
# ai-cli does not read this automatically: use node --env-file=tooling/.env.local.
AYAHX_TOOLKIT_PROVIDER=openai
AYAHX_TOOLKIT_BASE_URL=https://api.openai.com/v1
AYAHX_TOOLKIT_API_KEY=
AYAHX_TOOLKIT_MODEL=
# Loopback-only local ComfyUI endpoint.
AYAHX_COMFY_URL=http://127.0.0.1:8188
# AutoGPT remains a separately installed application.
AYAHX_AUTOGPT_URL=http://127.0.0.1:8000

# ==============================================================================
# Quran Reels & Ibtahalat Maker - Environment Configuration Template
# Copy this file to .env and configure your local or deployment parameters.
# NEVER commit real credentials, production secrets, or API keys to this file.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Authentication Security (Must be set to a secure 256-bit secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# MySQL 8.0+ Database Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=quran_reels

# AI Services (Optional - Used for audio transcription and timing refinement)
# Supports Google Gemini API (gemini-1.5-flash) or Lovable AI Gateway
GEMINI_API_KEY=
LOVABLE_API_KEY=

# Third-Party Stock Video Search (Optional - Pexels Video API)
# Injected server-side via /api/services/pexels/search; keep out of client builds
PEXELS_API_KEY=

# Production rendering: keep API nodes stateless and run `npm run worker` in
# separate worker containers. Leave driver as database for local development.
RENDER_QUEUE_DRIVER=database
REDIS_URL=redis://localhost:6379
RENDER_WORKER_CONCURRENCY=auto
RENDER_WORKER_ID=
# Each production worker consumes only its own BullMQ queue. The API should
# leave this unset; a worker service must set one of these three values.
RENDER_WORKER_ENGINE=ffmpeg_ass
# Optional render speed controls. The production worker sets these explicitly;
# leave the preset blank locally to use the quality profile defaults.
MAX_CONCURRENT_RENDERS=auto
RENDER_MAX_CONCURRENCY=auto
# Per-engine memory admission profiles. Do not replace these with one global
# 100/50 setting: Chromium and FFmpeg child processes need headroom.
FFMPEG_RENDER_MEMORY_PER_JOB_MB=128
FFMPEG_RENDER_MEMORY_RESERVE_MB=256
SKIA_RENDER_MEMORY_PER_JOB_MB=256
SKIA_RENDER_MEMORY_RESERVE_MB=256
BROWSER_RENDER_MEMORY_PER_JOB_MB=650
BROWSER_RENDER_MEMORY_RESERVE_MB=350
RENDER_CAPACITY_POLL_MS=5000
RENDER_FFMPEG_PRESET=
RENDER_FFMPEG_THREADS=0
RENDER_JPEG_QUALITY=90
RENDER_SCREENSHOT_OPTIMIZE=true
# Keep Chromium/CDP calls recoverable on long renders. The frame-level
# deadline is shorter and recycles the browser when it stops responding.
RENDER_PROTOCOL_TIMEOUT_MS=300000
RENDER_FRAME_OPERATION_TIMEOUT_MS=45000
RENDER_FRAME_RECOVERY_ATTEMPTS=2
# 0 means automatic: 1080p uses 90 frames, 4K uses 45 frames.
RENDER_BROWSER_FRAME_BATCH_SIZE=0
# Keep compositor capture on by default so every canvas update is captured.
# Set false only after validating that a specific Chromium build has no stale
# frame behaviour with view capture.
RENDER_SCREENSHOT_FROM_SURFACE=true

# Shared artifact storage. Use S3-compatible Cloudflare R2, AWS S3 or MinIO.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
METRICS_TOKEN=
